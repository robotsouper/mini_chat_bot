# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# Telegram bot token from @BotFather (required)
TELEGRAM_TOKEN=

# Anthropic API key from console.anthropic.com (required)
# Note: this is the pay-as-you-go API, separate from any Claude Pro subscription.
ANTHROPIC_API_KEY=

# Claude model to use (optional; defaults to claude-sonnet-4-6)
MODEL=claude-sonnet-4-6

# Comma-separated Telegram chat IDs the bot is allowed to operate in.
# Messages from any other chat are ignored. Empty = the bot ignores everything.
# Group/supergroup IDs are negative (e.g. -1001234567890); to find an ID, run
# the bot and send /whereami in the chat.
ALLOWED_CHAT_IDS=

# Postgres connection string for durable conversation memory (optional).
# On Railway, add a Postgres service and reference its DATABASE_URL instead of
# pasting one. Leave empty locally to keep memory in-process — the bot still
# works, but forgets everything when it restarts.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=
